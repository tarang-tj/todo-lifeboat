{
  "name": "todo-lifeboat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Move Microsoft To Do tasks to Todoist, Google Tasks, or a file, with a per-destination preview and a read-back receipt.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
